# Обязательно: случайная строка не короче 32 символов (python3 -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
# Dev: sqlite. Прод: postgresql+psycopg://crm:ПАРОЛЬ@db:5432/crm
DATABASE_URL=sqlite:///./data/crm.db
STORAGE_DIR=./data/files
# 1 за HTTPS (прод), 0 только для локальной проверки по http
HTTPS_ONLY=1
# Токен, с которым сайт отправляет заявки в POST /api/leads (пусто = endpoint выключен)
LEAD_API_TOKEN=
MAX_UPLOAD_MB=25
# Наценки по умолчанию для новых расчётов (правила компании)
DEFAULT_K_MTR=1.20
DEFAULT_K_SMR=1.356
DEFAULT_VAT=0.22
# Шапка КП (после регистрации юрлица). Реквизиты — строки через |
COMPANY_LEGAL_NAME=
COMPANY_REQUISITES=
REQUEST_CONTACT_TEXT=По техническим вопросам свяжитесь, пожалуйста, с нашим ответственным специалистом.

# Токен для POST /api/events: телефония, почта, мессенджеры присылают события (пусто = endpoint выключен)
EVENTS_API_TOKEN=
# Telegram-уведомления сотрудникам (только обезличенный текст со ссылкой в CRM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Публичный адрес CRM для ссылок в уведомлениях, без слэша в конце
PUBLIC_BASE_URL=
# Cron на сервере: python -m app.cli notify-due (каждые 10 минут), python -m app.cli check-fgis (раз в сутки)
# Telegram-бот пересчёта наценок (python -m app.cli run-bot): id чатов через запятую, остальным бот не отвечает
TELEGRAM_ALLOWED_CHAT_IDS=

# Подпись в письмах (после подключения телефона и почты)
COMPANY_PHONE=
COMPANY_EMAIL=

# Публичный приём заявок с сайта и консультанта (POST /api/public/lead). 0 = выключен.
PUBLIC_LEADS_ENABLED=0
# Разрешённые адреса сайта через запятую (проверяется заголовок Origin), например https://example.ru
PUBLIC_SITE_ORIGINS=
PUBLIC_RATE_LIMIT_PER_HOUR=10
# Версия текста согласия, записывается в историю заявки
CONSENT_VERSION=draft
