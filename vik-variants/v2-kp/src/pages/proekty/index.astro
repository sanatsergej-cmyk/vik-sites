---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import IntakeForm from '../../components/IntakeForm.astro';
import { projects, cases, cta } from '../../content.mjs';
import { ui } from '../../ui.mjs';
const has = cases.length > 0;
// Пустое состояние: макет будущей карточки проекта (поля из ui.case) и причина, почему раздел пока пуст.
const fields = [ui.case.object, ui.case.role, ui.case.scope, ui.case.approvals, ui.case.result, ui.case.documents];
---
<Base title={projects.title} description={projects.description} path="/proekty/" noindex={!has} crumbs={[{ name: ui.home, href: '/' }, { name: ui.nav.projects, href: '/proekty/' }]}>
  <PageHero crumbs={[{ name: ui.nav.projects }]} title={projects.h1} lead={projects.lead} hl="15%" />
  {has ? (
    <section class="block">
      <div class="container">
        <div class="cards">
          {cases.map((c) => (
            <a class="card rv" href={`/proekty/${c.slug}/`}>
              <h3>{c.title}</h3>
              <p>{c.object}</p>
              <p class="small">{ui.case.role}: {c.role}</p>
              <span class="go">{ui.more} <Icon name="arrow" size={18} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="block empty-sec">
      <div class="container cols">
        <div class="rv">
          <h2 class="block-title">{ui.projectsWill}</h2>
          <div class="case-ghost" aria-hidden="true">
            <div class="cg-media"><span class="mono">{ui.case.label}</span></div>
            <dl>{fields.map((f, i) => <><dt class="mono">{f}</dt><dd><span style={`--w:${[72, 48, 86, 60, 54, 40][i]}%`}></span></dd></>)}</dl>
          </div>
        </div>
        <div class="rv">
          <h2 class="block-title">{ui.projectsWhy}</h2>
          <p class="empty-text">{projects.empty}</p>
          <a class="btn btn-gold btn-lg" href="#intake">{cta.primary} <Icon name="arrow" size={20} /></a>
        </div>
      </div>
    </section>
  )}
  <IntakeForm title={cta.similar} />
</Base>
