---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { nav, notFound } from '../content.mjs';
import { ui } from '../ui.mjs';
---
<Base title={notFound.title} description={notFound.h1} path="/404/" noindex hasForm={false}>
  <section class="page-hero nf">
    <div class="container">
      <p class="eyebrow">{ui.notFoundCode}</p>
      <h1>{notFound.h1}</h1>
      <p class="lead">{notFound.lead}</p>
      <a class="btn btn-gold btn-lg" href="/">{notFound.back} <Icon name="arrow" size={20} /></a>
      <div class="chips" style="margin-top:40px">
        {[...nav.directions, ...nav.services, ...nav.works].map((l) => <a class="chip" href={l.href}>{l.label}<Icon name="arrow" size={16} /></a>)}
      </div>
    </div>
    <span class="hero-line" style="--hl:4%" aria-hidden="true"></span>
  </section>
</Base>
