---
// Линейные схемы волны 2 (графит + изумруд). Это условные схемы, не чертежи объекта: подпись «Схема».
// Пути с классом sc-draw прорисовываются при появлении (pathLength=1, stroke-dashoffset); без JS и при
// reduced-motion схема видна сразу. Подписи — только служебные термины из ui.sch.
import { ui } from '../ui.mjs';
const { kind, caption } = Astro.props;
const s = ui.sch;
const hatch = (y, x0 = 0, x1 = 1000, step = 22) => Array.from({ length: Math.floor((x1 - x0) / step) }, (_, i) => `M${x0 + 8 + i * step} ${y}l-12 14`).join('');
const floors = [0, 1, 2, 3];
const segs = [0, 1, 2, 3, 4, 5];
---
<figure class={`scheme rv scheme-${kind}`}>
  <div class="scheme-scroll">
    <svg viewBox="0 0 1000 440" role="img" aria-label={`${ui.schemeTag}: ${caption ?? ''}`}>
      {kind === 'vodosnabzhenie' && (
        <g>
          <path class="sc-ground" d="M0 150H1000" /><path class="sc-hatch" d={hatch(150, 0, 690)} />
          <path class="sc-line" d="M700 150V40h260v110M700 150v170h260V150" /><path class="sc-faint" d="M700 95h260M760 40v110M820 40v110M880 40v110" />
          <path class="sc-line" d="M200 150v210h64V150" /><path class="sc-faint" d="M192 144h80" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M0 330H232V300H770" style="--d:0.1" />
          <circle class="sc-ring" cx="800" cy="300" r="22" /><path class="sc-pipe" d="M786 286l28 28M786 314l28-28" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M822 300H900V70" style="--d:0.6" />
          <path class="sc-flow" d="M0 330H232V300H800H900V70" />
          <circle class="sc-node" cx="232" cy="330" r="6" /><circle class="sc-node" cx="700" cy="300" r="6" />
          <text class="sc-t" x="20" y="315">{s.cityMain}</text>
          <text class="sc-t" x="168" y="392">{s.well}</text>
          <text class="sc-t sc-em" x="620" y="285">{s.inlet}</text>
          <text class="sc-t sc-em" x="745" y="350">{s.meter}</text>
          <text class="sc-t" x="790" y="30">{s.building}</text>
          <text class="sc-t sc-dim" x="20" y="138">{s.ground}</text>
        </g>
      )}
      {kind === 'teplosnabzhenie' && (
        <g>
          <path class="sc-ground" d="M0 150H1000" /><path class="sc-hatch" d={hatch(150, 0, 660)} />
          <path class="sc-line" d="M90 150v200h150V150" /><path class="sc-faint" d="M80 144h170" />
          <path class="sc-line" d="M660 150V30h320v120M660 150v200h320V150" />
          <rect class="sc-box" x="700" y="220" width="130" height="100" rx="4" />
          <path class="sc-faint" d="M720 236v68M740 236v68M760 236v68M780 236v68M800 236v68" />
          <path class="sc-warm sc-draw" pathLength="1" d="M0 250H700" style="--d:0.1" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M0 290H700" style="--d:0.3" />
          <path class="sc-flow sc-flow-warm" d="M0 250H700" /><path class="sc-flow sc-flow-rev" d="M700 290H0" />
          <path class="sc-warm sc-draw" pathLength="1" d="M830 240H900V60H940" style="--d:0.8" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M830 300H930V60" style="--d:0.9" />
          <rect class="sc-box" x="600" y="236" width="40" height="28" rx="3" /><path class="sc-faint" d="M608 250h24" />
          <text class="sc-t" x="96" y="378">{s.chamber}</text>
          <text class="sc-t sc-warm-t" x="300" y="238">{s.supply}</text>
          <text class="sc-t sc-em" x="300" y="318">{s.ret}</text>
          <text class="sc-t sc-em" x="740" y="342">{s.itp}</text>
          <text class="sc-t" x="560" y="222">{s.heatMeter}</text>
          <text class="sc-t" x="760" y="22">{s.heating}</text>
        </g>
      )}
      {kind === 'elektrosnabzhenie' && (
        <g>
          <path class="sc-ground" d="M0 170H1000" /><path class="sc-hatch" d={hatch(170, 0, 680)} />
          <rect class="sc-box" x="60" y="70" width="150" height="100" rx="4" />
          <circle class="sc-ring" cx="120" cy="120" r="22" /><circle class="sc-ring" cx="150" cy="120" r="22" />
          <path class="sc-line" d="M690 170V40h270v130" /><rect class="sc-box" x="740" y="80" width="70" height="90" rx="3" />
          <path class="sc-faint" d="M752 96h46M752 112h46M752 128h46M752 144h46" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M135 170V290H740V170" style="--d:0.1" />
          <path class="sc-flow" d="M135 170V290H740V170" />
          {[300, 470, 620].map((x) => <g><rect class="sc-joint" x={x - 9} y="281" width="18" height="18" rx="3" /></g>)}
          <path class="sc-pipe sc-draw" pathLength="1" d="M810 110H900M810 130H930M810 150H900" style="--d:0.8" />
          {[900, 930, 900].map((x, i) => <circle class="sc-node" cx={x} cy={110 + i * 20} r="5" />)}
          <text class="sc-t sc-em" x="110" y="58">{s.tp}</text>
          <text class="sc-t" x="360" y="328">{s.kl}</text>
          <text class="sc-t sc-dim" x="440" y="270">{s.joint}</text>
          <text class="sc-t sc-em" x="752" y="196">{s.vru}</text>
          <text class="sc-t" x="790" y="28">{s.loads}</text>
        </g>
      )}
      {kind === 'ventilyatsiya' && (
        <g>
          <path class="sc-line" d="M260 420V40h480v380" />
          {floors.map((f) => <path class="sc-faint" d={`M260 ${120 + f * 80}H740`} />)}
          <rect class="sc-box" x="300" y="48" width="150" height="62" rx="4" />
          <circle class="sc-ring" cx="340" cy="79" r="18" /><path class="sc-faint" d="M370 64h64M370 79h64M370 94h64" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M450 70H600V400" style="--d:0.1" />
          <path class="sc-warm sc-draw" pathLength="1" d="M450 90H560V400" style="--d:0.2" />
          {floors.map((f) => (
            <g>
              <path class="sc-pipe" d={`M600 ${160 + f * 80}H700`} /><path class="sc-warm" d={`M560 ${172 + f * 80}H300`} />
              <path class="sc-faint" d={`M690 ${152 + f * 80}v16M680 ${152 + f * 80}v16M310 ${164 + f * 80}v16M320 ${164 + f * 80}v16`} />
            </g>
          ))}
          <path class="sc-flow" d="M450 70H600V400" /><path class="sc-flow sc-flow-warm sc-flow-rev" d="M560 400V90H450" />
          <text class="sc-t sc-em" x="300" y="34">{s.ventRoom}</text>
          <text class="sc-t" x="770" y="160">{s.duct}</text>
          <text class="sc-t sc-em" x="770" y="190">{s.supplyAir}</text>
          <text class="sc-t sc-warm-t" x="770" y="220">{s.exhaust}</text>
          {floors.map((f) => <text class="sc-t sc-dim" x="200" y={164 + f * 80}>{`${s.floor} ${4 - f}`}</text>)}
        </g>
      )}
      {kind === 'gazosnabzhenie' && (
        <g>
          <path class="sc-ground" d="M0 230H1000" /><path class="sc-hatch" d={hatch(230, 0, 700)} />
          <path class="sc-line" d="M700 230V50h260v180" /><path class="sc-faint" d="M760 50v180M820 50v180M880 50v180M700 140h260" />
          <circle class="sc-ring" cx="90" cy="330" r="18" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M108 330H600V200H680V140H700" style="--d:0.1" />
          <path class="sc-flow" d="M108 330H600V200H680V140H700" />
          <circle class="sc-node" cx="600" cy="230" r="6" /><circle class="sc-node" cx="700" cy="140" r="6" />
          <text class="sc-t sc-em" x="40" y="380">{s.gasPoint}</text>
          <text class="sc-t" x="250" y="365">{s.gasUnder}</text>
          <text class="sc-t" x="470" y="186">{s.gasFacade}</text>
          <text class="sc-t" x="790" y="38">{s.object}</text>
          <text class="sc-t sc-dim" x="20" y="218">{s.ground}</text>
        </g>
      )}
      {kind === 'earthworks' && (
        <g>
          <path class="sc-layer l1" d="M0 80H1000V104H0z" /><path class="sc-layer l2" d="M0 104H1000V220H0z" /><path class="sc-layer l3" d="M0 220H1000V440H0z" />
          <path class="sc-cut" d="M380 80l40 300h160l40-300z" />
          <path class="sc-line sc-draw" pathLength="1" d="M380 80l40 300h160l40-300" style="--d:0.1" />
          <path class="sc-line" d="M418 120h164M414 200h172M410 280h180" /><path class="sc-faint" d="M430 110v200M570 110v200" />
          <path class="sc-bed" d="M424 320h152v60H424z" />
          <circle class="sc-ring sc-ring-em" cx="500" cy="330" r="26" />
          <path class="sc-faint" d={hatch(80, 0, 360)} /><path class="sc-faint" d={hatch(80, 640, 1000)} />
          <text class="sc-t" x="40" y="70">{s.cover}</text>
          <text class="sc-t" x="40" y="170">{s.soil}</text>
          <text class="sc-t sc-em" x="660" y="350">{s.bedding}</text>
          <text class="sc-t" x="660" y="250">{s.backfill}</text>
          <text class="sc-t" x="660" y="150">{s.shoring}</text>
          <text class="sc-t sc-em" x="455" y="420">{s.trench}</text>
        </g>
      )}
      {kind === 'pipeline-install' && (
        <g>
          <path class="sc-ground" d="M0 120H1000" /><path class="sc-hatch" d={hatch(120)} />
          <path class="sc-faint" d="M60 300H940" />
          {segs.map((i) => (
            <g class="sc-seg" style={`--k:${i}`}>
              <rect class="sc-pipe-seg" x={70 + i * 145} y="268" width="140" height="64" rx="6" />
              <path class="sc-faint" d={`M${90 + i * 145} 282h100`} />
            </g>
          ))}
          {segs.slice(1).map((i) => <path class="sc-weld" d={`M${67 + i * 145} 262v76`} style={`--k:${i}`} />)}
          <text class="sc-t" x="70" y="380">{`${s.section} 01`}</text>
          <text class="sc-t sc-em" x="345" y="250">{s.weld}</text>
          <text class="sc-t sc-dim" x="20" y="108">{s.ground}</text>
        </g>
      )}
      {kind === 'cable-install' && (
        <g>
          <path class="sc-ground" d="M0 160H1000" /><path class="sc-hatch" d={hatch(160, 0, 720)} />
          <rect class="sc-box" x="40" y="70" width="120" height="90" rx="4" /><circle class="sc-ring" cx="85" cy="115" r="18" /><circle class="sc-ring" cx="113" cy="115" r="18" />
          <path class="sc-line" d="M720 160V40h250v120M720 160v140h250V160" /><rect class="sc-box" x="800" y="200" width="60" height="80" rx="3" />
          <path class="sc-bed" d="M100 250H720v40H100z" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M100 160V270H720V240H800" style="--d:0.1" />
          {[270, 450, 610].map((x) => <rect class="sc-joint" x={x - 10} y="260" width="20" height="20" rx="3" />)}
          <path class="sc-flow" d="M100 160V270H720V240H800" />
          <text class="sc-t sc-em" x="70" y="58">{s.tp}</text>
          <text class="sc-t" x="300" y="320">{s.kl}</text>
          <text class="sc-t sc-dim" x="430" y="244">{s.joint}</text>
          <text class="sc-t sc-em" x="650" y="226">{s.inlet}</text>
          <text class="sc-t" x="800" y="304">{s.vru}</text>
        </g>
      )}
      {kind === 'itp-design' && (
        <g class="sc-iso">
          <path class="sc-faint" d="M120 360l380-180 380 180-380 180z" />
          <path class="sc-line sc-draw" pathLength="1" d="M330 300l120-58v-120l-120 58zM330 300l60 28 120-58-60-28" style="--d:0.1" />
          {[0, 1, 2, 3, 4].map((i) => <path class="sc-faint" d={`M${348 + i * 18} ${292 - i * 8.6}v-110`} />)}
          <path class="sc-line" d="M560 290a26 13 0 1 0 52 0a26 13 0 1 0-52 0M586 277v-40M650 320a26 13 0 1 0 52 0a26 13 0 1 0-52 0M676 307v-40" />
          <path class="sc-warm sc-draw" pathLength="1" d="M160 240l170-80M450 130l136 64v40M586 237l90 43" style="--d:0.4" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M200 300l130-60M510 270l140 64M676 307l150 70" style="--d:0.6" />
          <rect class="sc-box" x="720" y="150" width="90" height="60" rx="4" /><path class="sc-faint" d="M732 166h66M732 180h40M732 194h54" />
          <text class="sc-t sc-em" x="300" y="100">{s.hx}</text>
          <text class="sc-t" x="580" y="210">{s.pumps}</text>
          <text class="sc-t" x="720" y="138">{s.auto}</text>
          <text class="sc-t sc-warm-t" x="60" y="206">{s.supply}</text>
          <text class="sc-t sc-em" x="150" y="330">{s.ret}</text>
        </g>
      )}
      {kind === 'relocation' && (
        <g>
          {[0, 1].map((p) => (
            <g transform={`translate(${p * 510} 0)`}>
              <rect class="sc-box" x="10" y="30" width="470" height="380" rx="6" />
              <rect class="sc-plot" x="140" y="120" width="210" height="200" rx="2" />
              {p === 0 ? (
                <g><path class="sc-pipe" d="M10 220H480" /><path class="sc-flow" d="M10 220H480" /></g>
              ) : (
                <g>
                  <path class="sc-dead" d="M140 220H350" />
                  <path class="sc-pipe sc-draw" pathLength="1" d="M10 220H90V360H400V220H480" style="--d:0.3" />
                  <path class="sc-flow" d="M10 220H90V360H400V220H480" />
                </g>
              )}
              <text class="sc-t sc-big" x="30" y="70">{p === 0 ? ui.w2.before : ui.w2.after}</text>
              <text class="sc-t sc-dim" x="160" y="150">{s.plot}</text>
              <text class={`sc-t ${p === 0 ? '' : 'sc-em'}`} x="30" y="205">{p === 0 ? s.oldNet : s.newNet}</text>
              {p === 1 && <text class="sc-t sc-dim" x="190" y="245">{s.removed}</text>}
            </g>
          ))}
        </g>
      )}
      {kind === 'expertise' && (
        <g>
          <circle class="sc-faint" cx="500" cy="220" r="150" />
          <path class="sc-pipe sc-draw" pathLength="1" d="M500 70a150 150 0 0 1 130 225M370 295a150 150 0 0 1 130-225M630 295a150 150 0 0 1-260 0" style="--d:0.1" />
          <g class="sc-orbit"><circle class="sc-head" cx="500" cy="70" r="8" /></g>
          {[[500, 70, s.remark, 'middle'], [630, 295, s.answer, 'start'], [370, 295, s.fix, 'end']].map(([x, y, t, a]) => (
            <g><circle class="sc-ring sc-ring-em" cx={x} cy={y} r="22" /><text class="sc-t sc-em" x={a === 'start' ? Number(x) + 36 : a === 'end' ? Number(x) - 36 : x} y={a === 'middle' ? Number(y) - 36 : Number(y) + 5} text-anchor={a}>{t}</text></g>
          ))}
          <text class="sc-t sc-big" x="500" y="228" text-anchor="middle">{s.expertise}</text>
        </g>
      )}
    </svg>
  </div>
  <figcaption><span class="mono">{ui.schemeTag}</span>{caption}</figcaption>
</figure>
