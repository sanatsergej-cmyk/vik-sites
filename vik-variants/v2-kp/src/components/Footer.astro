---
// Подвал: лого, CTA, контакты, колонки навигации (на мобильном — аккордеон <details>), реквизиты из footer.*, «Наверх».
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, footer, documents, cta, brand } from '../content.mjs';
import { ui } from '../ui.mjs';
const c = footer.contacts;
const phone = (documents.requisites.find(([k]) => k === 'Телефон') ?? [])[1] ?? '';
const tel = phone.replace(/[^\d+]/g, '');
const cols = [
  { t: ui.nav.directions, items: nav.directions },
  { t: ui.nav.services, items: [...nav.services, ...(nav.extras ?? [])] },
  { t: ui.nav.works, items: nav.works },
  nav.knowledge && { t: nav.knowledge.label, items: [{ label: ui.kb.all, href: nav.knowledge.href }, ...(nav.articles ?? []).slice(0, 4)] },
  { t: ui.nav.company, items: [
    { label: ui.nav.about, href: '/o-kompanii/' }, { label: ui.nav.projects, href: '/proekty/' }, { label: ui.nav.documents, href: '/dokumenty/' },
    { label: ui.nav.contacts, href: '/kontakty/' }, { label: ui.nav.privacy, href: '/privacy/' }, { label: ui.nav.consent, href: '/consent/' },
  ] },
].filter(Boolean);
---
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <Logo size={36} />
      <p class="footer-tag">{brand.tagline}</p>
      <p class="muted">{footer.about}</p>
      <a class="btn btn-gold btn-lg footer-cta" href="/kontakty/#intake">{cta.primary} <Icon name="arrow" size={20} /></a>
    </div>
    <ul class="footer-contacts">
      <li><span class="mono">{c.phone}</span>{phone && <a href={`tel:${tel}`}>{phone}</a>}</li>
      <li><span class="mono">{c.email}</span><span data-placeholder>{c.pendingEmail}</span></li>
      <li><span class="mono">{c.telegram}</span><span data-placeholder>{c.pendingContact}</span></li>
      <li><span class="mono">{c.address}</span><span data-placeholder>{c.pendingAddress}</span></li>
    </ul>
  </div>
  <nav class="container footer-nav" aria-label={ui.navMain}>
    {cols.map((col) => (
      <details class="fcol" open>
        <summary class="mono">{col.t}<Icon name="plus" size={18} /></summary>
        <ul>{col.items.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </details>
    ))}
  </nav>
  <div class="container footer-bottom">
    <div>
      <p>{footer.copyright}</p>
      <p>{footer.disclaimer}</p>
    </div>
    <a class="to-top mono" href="#top">{ui.toTop} <Icon name="arrowDown" size={16} /></a>
  </div>
</footer>
