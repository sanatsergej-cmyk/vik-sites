# 0 = закрытый стенд: noindex, Disallow в robots.txt, без sitemap. 1 = публичный запуск.
ENABLE_PUBLIC_INDEXING=0
# Финальный домен без слэша в конце (canonical и sitemap при ENABLE_PUBLIC_INDEXING=1).
SITE_URL=https://example.ru
# Форма и консультант отправляют заявки в CRM. 0 = тестовый режим (ничего не отправляется).
PUBLIC_FORM_ENABLED=0
PUBLIC_LEAD_ENDPOINT=/api/public/lead
# Блок «С кем работаем» (список на утверждении). 1 только на закрытом стенде.
PUBLIC_CLIENTS_BLOCK=0
# Фото инженерных систем (принадлежность не подтверждена). 1 только на закрытом стенде.
PUBLIC_PHOTOS=0
# В V3 не используется (переключатель тем есть только в V1), оставлен для совпадения набора флагов.
PUBLIC_VARIANTS=0
