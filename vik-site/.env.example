# 0 = закрытый стенд: noindex, Disallow в robots.txt, без sitemap. 1 = публичный запуск.
# Включать только после регистрации юрлица, реквизитов и утверждённых юридических текстов.
ENABLE_PUBLIC_INDEXING=0

# Финальный домен без слэша в конце (нужен для canonical и sitemap при ENABLE_PUBLIC_INDEXING=1).
SITE_URL=https://example.ru

# Публичная форма и консультант отправляют заявки в CRM. 0 = тестовый режим (ничего не отправляется).
PUBLIC_FORM_ENABLED=0
PUBLIC_LEAD_ENDPOINT=/api/public/lead

# Блок «С кем работаем»: список на утверждении у заказчика. 1 только на закрытом стенде.
PUBLIC_CLIENTS_BLOCK=0
# Фото инженерных систем (принадлежность объектов не подтверждена). 1 только на закрытом стенде.
PUBLIC_PHOTOS=0
# Переключатель вариантов оформления (золото / индиго / светлый) для показа заказчику.
PUBLIC_VARIANTS=0
