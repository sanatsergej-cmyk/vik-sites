---
import { consultant, directions, services, stages } from '../content/index.mjs';

const enabled = import.meta.env.PUBLIC_FORM_ENABLED === '1';
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT || '/api/public/lead';
const data = {
  c: consultant,
  directions: directions.map((d) => ({ slug: d.slug, label: d.label })),
  services: services.map((s) => ({ id: s.id, label: s.label })),
  stages: stages,
  enabled,
  endpoint,
  kbUrl: '/kb.json',
};
---
<div id="vik-consultant" class="vc" hidden>
  <button type="button" class="vc-fab" id="vc-open" aria-expanded="false" aria-controls="vc-panel">{consultant.open}</button>
  <section class="vc-panel" id="vc-panel" role="dialog" aria-label={consultant.name} hidden>
    <header class="vc-head">
      <strong>{consultant.name}</strong>
      <button type="button" class="vc-x" id="vc-close" aria-label={consultant.close}>×</button>
    </header>
    <div class="vc-log" id="vc-log" aria-live="polite"></div>
    <div class="vc-chips" id="vc-chips"></div>
    <form class="vc-form" id="vc-form" autocomplete="off">
      <input id="vc-input" type="text" maxlength="1000" placeholder={consultant.placeholder} aria-label={consultant.placeholder} />
      <button type="submit">{consultant.send}</button>
    </form>
  </section>
  <script type="application/json" id="vc-data" set:html={JSON.stringify(data)} />
</div>

<script is:inline>
(function () {
  var root = document.getElementById('vik-consultant');
  if (!root) return;
  var D = JSON.parse(document.getElementById('vc-data').textContent);
  var C = D.c, F = C.flow;
  var log = document.getElementById('vc-log'), chips = document.getElementById('vc-chips');
  var form = document.getElementById('vc-form'), input = document.getElementById('vc-input');
  var panel = document.getElementById('vc-panel'), fab = document.getElementById('vc-open');
  var KB = null, started = false;
  var STOP = {}; 'что как для это или при над под про его она они вас нас ваш наш есть быть можно нужно если чем где кто когда какие какой какая будет также только очень'.split(' ').forEach(function (w) { STOP[w] = 1; });
  var state = { step: 'idle', data: { direction: '', service: '', stage: '', object: '', task: '', contact: '', name: '' }, transcript: [], files: [] };

  root.hidden = false;
  // На узких экранах кнопка консультанта не перекрывает первый экран: появляется после прокрутки.
  var mqNarrow = window.matchMedia('(max-width: 1023px)');
  function fabState() { root.classList.toggle('vc-away', mqNarrow.matches && window.scrollY < window.innerHeight * 0.6 && panel.hidden); }
  window.addEventListener('scroll', fabState, { passive: true }); window.addEventListener('resize', fabState); fabState();
  function norm(s) { return String(s).toLowerCase().replace(/ё/g, 'е').replace(/[^a-zа-я0-9\s]/g, ' '); }
  function stems(s) { return norm(s).split(/\s+/).filter(function (w) { return w.length > 2 && !STOP[w]; }).map(function (w) { return w.slice(0, 5); }); }
  function toSet(a) { var o = {}; a.forEach(function (x) { o[x] = 1; }); return o; }

  function loadKb(cb) {
    if (KB) return cb();
    fetch(D.kbUrl).then(function (r) { return r.json(); }).then(function (j) {
      KB = j.map(function (e) { e.tq = toSet(stems(e.title)); e.tt = toSet(stems(e.text)); return e; }); cb();
    }).catch(function () { KB = []; cb(); });
  }
  function search(q) {
    var qs = stems(q); if (!qs.length) return [];
    var price = /цен|стоим|сколько|смет|срок|долго/.test(norm(q));
    var res = KB.map(function (e) {
      var s = 0; qs.forEach(function (w) { if (e.tq[w]) s += 3; else if (e.tt[w]) s += 1; });
      if (price && s >= 3 && /стоимост/.test(norm(e.title))) s += 4;
      return { e: e, s: s };
    }).filter(function (x) { return x.s >= 3; }).sort(function (a, b) { return b.s - a.s; });
    return res.map(function (x) { return x.e; });
  }

  function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
  function say(role, text, link) {
    var m = el('div', 'vc-msg vc-' + role); m.appendChild(el('p', null, text));
    if (link) { var a = el('a', null, link.label); a.href = link.url; m.appendChild(a); }
    log.appendChild(m); log.scrollTop = log.scrollHeight;
    state.transcript.push((role === 'bot' ? 'Консультант: ' : 'Клиент: ') + text);
  }
  function setChips(items) {
    chips.innerHTML = '';
    items.forEach(function (it) {
      var b = el('button', 'vc-chip', it.label); b.type = 'button';
      b.addEventListener('click', function () { say('user', it.label); it.run(); }); chips.appendChild(b);
    });
  }
  function resetFlow() { state.step = 'idle'; state.data = { direction: '', service: '', stage: '', object: '', task: '', contact: '', name: '' }; state.files = []; }

  function menu() {
    state.step = 'menu';
    say('bot', C.menuPrompt);
    setChips([
      { label: C.menu.ask, run: function () { state.step = 'ask'; say('bot', C.askPrompt); setChips([]); input.focus(); } },
      { label: C.menu.submit, run: startFlow },
    ]);
  }
  function startFlow() { askSystem(); }
  function askSystem() {
    state.step = 'system'; say('bot', F.system);
    var items = D.directions.map(function (d) { return { label: d.label, run: function () { state.data.direction = d.slug; askWork(); } }; });
    items.push({ label: F.other, run: function () { askWork(); } });
    setChips(items);
  }
  function askWork() {
    state.step = 'work'; say('bot', F.work);
    var items = D.services.map(function (s) { return { label: s.label, run: function () { state.data.service = s.id; askStage(); } }; });
    items.push({ label: F.other, run: function () { askStage(); } });
    setChips(items);
  }
  function askStage() {
    state.step = 'stage'; say('bot', F.stage);
    setChips(D.stages.map(function (s) { return { label: s.label, run: function () { state.data.stage = s.label; askText('object'); } }; })
      .concat([{ label: F.other, run: function () { askText('object'); } }]));
  }
  function askText(step) { state.step = step; say('bot', F[step]); setChips([]); input.focus(); }
  function askName() { state.step = 'name'; say('bot', F.name); setChips([{ label: F.skip, run: confirm }]); input.focus(); }

  function validContact(v) { return /^[\w.+-]+@[\w-]+(\.[\w-]+)+$/.test(v) || /^@[\w]{4,}$/.test(v) || /^\+?[\d\s()-]{7,}$/.test(v); }
  function labelOf(list, key, val) { var f = list.filter(function (x) { return (x.slug || x.id) === val; })[0]; return f ? f.label : val; }

  function confirm() {
    state.step = 'confirm'; chips.innerHTML = '';
    var d = state.data, box = el('div', 'vc-msg vc-bot vc-confirm');
    box.appendChild(el('p', null, F.confirmTitle));
    var rows = [['direction', labelOf(D.directions, 'slug', d.direction)], ['service', labelOf(D.services, 'id', d.service)], ['stage', d.stage], ['object', d.object], ['task', d.task], ['contact', d.contact], ['name', d.name]];
    rows.forEach(function (r) { if (r[1]) { var p = el('p', 'vc-row'); p.appendChild(el('b', null, F.labels[r[0]] + ': ')); p.appendChild(document.createTextNode(r[1])); box.appendChild(p); } });
    var lbl = el('label', 'vc-consent'); var cb = el('input'); cb.type = 'checkbox'; cb.id = 'vc-consent';
    lbl.appendChild(cb); lbl.appendChild(document.createTextNode(' ' + F.consentBefore + ' ')); var a = el('a', null, F.consentLink); a.href = '/consent/'; a.target = '_blank'; lbl.appendChild(a); box.appendChild(lbl);
    if (D.enabled) {
      var fl = el('label', 'vc-file', F.files); var fi = el('input'); fi.type = 'file'; fi.multiple = true; fi.accept = '.pdf,.dwg,.dxf,.xls,.xlsx,.doc,.docx,.zip,.jpg,.jpeg,.png';
      fi.addEventListener('change', function () { state.files = Array.prototype.slice.call(fi.files, 0, 5); }); fl.appendChild(document.createElement('br')); fl.appendChild(fi); box.appendChild(fl);
    }
    var err = el('p', 'vc-err'); err.id = 'vc-err'; box.appendChild(err);
    var go = el('button', 'vc-go', F.submit); go.type = 'button'; go.addEventListener('click', submit);
    var again = el('button', 'vc-chip', F.edit); again.type = 'button'; again.addEventListener('click', function () { resetFlow(); menu(); });
    box.appendChild(go); box.appendChild(again); log.appendChild(box); log.scrollTop = log.scrollHeight;
  }

  function submit() {
    var err = document.getElementById('vc-err');
    if (!document.getElementById('vc-consent').checked) { err.textContent = F.consentNeeded; return; }
    err.textContent = '';
    if (!D.enabled) { say('bot', F.pending); state.step = 'done'; return; }
    var d = state.data, fd = new FormData();
    fd.append('name', d.name); fd.append('contact', d.contact); fd.append('task', d.task); fd.append('direction', d.direction);
    fd.append('service', d.service); fd.append('stage', d.stage); fd.append('object', d.object); fd.append('consent', '1');
    fd.append('source', 'consultant'); fd.append('transcript', state.transcript.join('\n').slice(0, 19000));
    state.files.forEach(function (f) { fd.append('files', f); });
    say('bot', F.sending);
    fetch(D.endpoint, { method: 'POST', body: fd, credentials: 'same-origin' }).then(function (r) {
      if (!r.ok) throw new Error(String(r.status)); say('bot', F.done); state.step = 'done'; chips.innerHTML = '';
    }).catch(function () { say('bot', F.error); });
  }

  function answer(q) {
    loadKb(function () {
      var hits = search(q);
      if (!hits.length) {
        say('bot', C.notFound);
        setChips([{ label: C.handOver, run: startFlow }, { label: C.askAnother, run: function () { state.step = 'ask'; say('bot', C.askPrompt); setChips([]); input.focus(); } }]);
        return;
      }
      var top = hits[0], extra = /цен|стоим|сколько|смет|срок|долго/.test(norm(q)) ? ' ' + C.priceNote : '';
      say('bot', top.text + extra, { label: C.moreInfo + ' ' + top.url, url: top.url });
      var more = hits.slice(1, 3);
      if (more.length) {
        say('bot', C.also);
        setChips(more.map(function (h) { return { label: h.title, run: function () { say('bot', h.text, { label: C.moreInfo + ' ' + h.url, url: h.url }); setChips([{ label: C.handOver, run: startFlow }, { label: C.askAnother, run: function () { say('bot', C.askPrompt); setChips([]); input.focus(); } }]); } }; })
          .concat([{ label: C.handOver, run: startFlow }]));
      } else {
        say('bot', C.askMore); setChips([{ label: C.handOver, run: startFlow }, { label: C.askAnother, run: function () { say('bot', C.askPrompt); setChips([]); input.focus(); } }]);
      }
    });
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault(); var v = input.value.trim(); if (!v) return; input.value = ''; say('user', v);
    var s = state.step;
    if ((s === 'object' || s === 'task' || s === 'contact' || s === 'name') && /\?\s*$/.test(v)) { answer(v); return; }
    if (s === 'object') { state.data.object = v; askText('task'); }
    else if (s === 'task') { state.data.task = v; askText('contact'); }
    else if (s === 'contact') { if (!validContact(v)) { say('bot', F.contactInvalid); return; } state.data.contact = v; askName(); }
    else if (s === 'name') { state.data.name = v; confirm(); }
    else { answer(v); }
  });

  function open() {
    panel.hidden = false; fab.setAttribute('aria-expanded', 'true'); fab.hidden = true;
    if (!started) { started = true; say('bot', C.greeting); menu(); try { var p = new URLSearchParams(location.search); if (p.get('service')) state.data.service = p.get('service'); if (p.get('direction')) state.data.direction = p.get('direction'); } catch (e) {} loadKb(function () {}); }
    input.focus();
  }
  function close() { panel.hidden = true; fab.hidden = false; fab.setAttribute('aria-expanded', 'false'); fab.focus(); }
  fab.addEventListener('click', open);
  document.getElementById('vc-close').addEventListener('click', close);
  panel.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
})();
</script>
