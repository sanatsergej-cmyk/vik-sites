---
// Подвал: эмблема, слоган и принципы, контакты и CTA, колонки разделов (на телефоне — аккордеон), нижняя строка.
// Всё из контента, без новых фактов.
import { nav, footer, brand, principles, cta } from '../content/index.mjs';
import EmblemVector from './EmblemVector.astro';
import Icon from './Icon.astro';
const c = footer.contacts;
const cols = [
  { t: 'Направления', links: nav.directions },
  { t: 'Услуги', links: nav.services, sub: { t: 'Дополнительные', links: nav.extras } },
  { t: 'Работы', links: nav.works },
  { t: nav.knowledge.label, href: nav.knowledge.href, links: nav.articles },
  {
    t: 'Компания',
    links: [
      { label: 'О компании', href: '/o-kompanii/' },
      { label: 'Проекты', href: '/proekty/' },
      { label: 'Документы и реквизиты', href: '/dokumenty/' },
      { label: 'Контакты', href: '/kontakty/' },
      { label: 'Политика обработки данных', href: '/privacy/' },
      { label: 'Согласие на обработку данных', href: '/consent/' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="footer-marble" aria-hidden="true"></div>
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="fb-logo" href="/" aria-label="ВиК — на главную">
        <EmblemVector class="fb-mark" idp="ft" />
        <span class="footer-word" aria-hidden="true">{brand.name}</span>
      </a>
      <p class="footer-tag">{brand.tagline}</p>
      <ul class="footer-principles">{principles.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="footer-contact">
      <ul class="contacts">
        <li><span class="k">{c.phone}</span><a href="tel:+79916663572">+7 991 666-35-72</a></li>
        <li><span class="k">{c.email}</span><span data-placeholder>{c.pendingEmail}</span></li>
        <li><span class="k">{c.telegram}</span><span data-placeholder>{c.pendingContact}</span></li>
        <li><span class="k">География</span><span class="fc-v">{brand.region}</span></li>
        <li class="fc-wide"><span class="k">Первичная оценка</span><span class="fc-v"><Icon name="clock" size={15} /> {brand.eta}</span></li>
      </ul>
      <a class="btn btn-gold" href="/kontakty/#intake"><span>{cta.primary}</span><span class="btn-ico"><Icon name="arrow" size={16} /></span></a>
    </div>
  </div>
  <div class="container footer-grid">
    {cols.map((col) => (
      <details class="fcol" open>
        <summary><h3>{col.href ? <a href={col.href}>{col.t}</a> : col.t}</h3><span class="fcol-plus" aria-hidden="true"></span></summary>
        <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        {col.sub && col.sub.links.length > 0 && (
          <>
            <p class="fcol-sub">{col.sub.t}</p>
            <ul>{col.sub.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </>
        )}
      </details>
    ))}
  </div>
  <div class="container footer-bottom">
    <div>
      <p>{footer.copyright}</p>
      <p>{footer.disclaimer}</p>
    </div>
    <a class="to-top" href="#main"><span>Наверх</span><span class="btn-ico"><Icon name="arrow" size={14} /></span></a>
  </div>
  <script is:inline>
    (function () {
      if (!window.matchMedia('(max-width: 640px)').matches) return;
      document.querySelectorAll('.site-footer .fcol').forEach(function (d) { d.open = false; });
    })();
  </script>
</footer>
