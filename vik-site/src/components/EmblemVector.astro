---
// Векторная эмблема ВиК по утверждённому варианту №6 (золото, 4 системы, 09.10):
// золотая треугольная рамка, внутри — вода (волны и капля), башни-здания, лист,
// под «крышей» — пламя с молнией и медные трубы. Без текста.
// idp — префикс id градиентов: на странице может быть несколько эмблем (шапка, первый экран, интро).
// Классы ev-* используются анимацией интро (сборка по частям).
const { class: cls = '', idp = 'ev', title = '', decorative = true } = Astro.props;
const id = (s: string) => `${idp}-${s}`;
const u = (s: string) => `url(#${idp}-${s})`;
// башни: задний ряд (высокие) и передний (низкие, темнее) — как в утверждённой эмблеме
const towers = [
  { x: 236, w: 20, top: 204 },
  { x: 257, w: 22, top: 142 },
  { x: 280, w: 20, top: 94 },
  { x: 301, w: 22, top: 56 },
  { x: 324, w: 18, top: 128 },
  { x: 343, w: 14, top: 190 },
];
const front = [
  { x: 266, w: 24, top: 214 },
  { x: 310, w: 22, top: 196 },
];
// волны идут вдоль «крыши» (уклон 0.7386) в левом секторе
const wave = (off: number, amp: number, x0: number, x1: number, ph = 0) => {
  const pts: string[] = [];
  for (let x = x0; x <= x1; x += 4) {
    const y = 228 + (300 - x) * 0.7386 - off + Math.sin((x + ph) / 24) * amp * (0.6 + 0.4 * Math.sin(x / 61));
    pts.push(`${x.toFixed(0)} ${y.toFixed(1)}`);
  }
  return 'M' + pts.join('L');
};
const waves = [
  { d: wave(10, 9, 40, 252, 0), w: 13, o: 1 },
  { d: wave(34, 9, 40, 246, 14), w: 10, o: 1 },
  { d: wave(58, 8, 60, 236, 28), w: 7, o: 0.85 },
  { d: wave(80, 6, 84, 222, 42), w: 4.5, o: 0.6 },
];
---
<svg
  class:list={['emblem-vector', cls]}
  viewBox="0 0 600 420"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : title}
  focusable="false"
>
  <defs>
    <linearGradient id={id('frame')} gradientUnits="userSpaceOnUse" x1="60" y1="20" x2="540" y2="420">
      <stop offset="0" stop-color="#fff6d2" />
      <stop offset=".14" stop-color="#e6b54e" />
      <stop offset=".3" stop-color="#8a5c14" />
      <stop offset=".46" stop-color="#fde7a6" />
      <stop offset=".6" stop-color="#b98222" />
      <stop offset=".76" stop-color="#f6d685" />
      <stop offset=".9" stop-color="#9c6b1a" />
      <stop offset="1" stop-color="#e7c068" />
    </linearGradient>
    <linearGradient id={id('bevel')} gradientUnits="userSpaceOnUse" x1="540" y1="40" x2="60" y2="400">
      <stop offset="0" stop-color="#6b4710" />
      <stop offset=".3" stop-color="#c99838" />
      <stop offset=".5" stop-color="#5e3d0c" />
      <stop offset=".75" stop-color="#d6a644" />
      <stop offset="1" stop-color="#5a3a0b" />
    </linearGradient>
    <linearGradient id={id('frame2')} x1="1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff6d6" stop-opacity=".9" />
      <stop offset=".5" stop-color="#ffe7a6" stop-opacity="0" />
      <stop offset="1" stop-color="#fff0c0" stop-opacity=".55" />
    </linearGradient>
    <linearGradient id={id('chev')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff0c0" />
      <stop offset=".35" stop-color="#e2ae46" />
      <stop offset=".7" stop-color="#a8761f" />
      <stop offset="1" stop-color="#6e4a10" />
    </linearGradient>
    <linearGradient id={id('bg')} gradientUnits="userSpaceOnUse" x1="90" y1="300" x2="510" y2="300">
      <stop offset="0" stop-color="#061844" />
      <stop offset=".3" stop-color="#0b2766" />
      <stop offset=".5" stop-color="#08142c" />
      <stop offset=".7" stop-color="#102c12" />
      <stop offset="1" stop-color="#173f16" />
    </linearGradient>
    <linearGradient id={id('wave')} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#1546c8" />
      <stop offset=".55" stop-color="#3f8cff" />
      <stop offset="1" stop-color="#a9d2ff" />
    </linearGradient>
    <linearGradient id={id('drop')} x1=".2" y1="0" x2=".8" y2="1">
      <stop offset="0" stop-color="#bfe0ff" />
      <stop offset=".45" stop-color="#3d8bff" />
      <stop offset="1" stop-color="#0a3aa8" />
    </linearGradient>
    <linearGradient id={id('tower')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#b9dcff" />
      <stop offset=".3" stop-color="#4f8ff5" />
      <stop offset=".5" stop-color="#1f56c6" />
      <stop offset=".51" stop-color="#143f9e" />
      <stop offset="1" stop-color="#071d52" />
    </linearGradient>
    <linearGradient id={id('tower2')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#5f98f0" />
      <stop offset=".5" stop-color="#1d55c4" />
      <stop offset="1" stop-color="#0a2258" />
    </linearGradient>
    <linearGradient id={id('leaf')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#d5ef8a" />
      <stop offset=".45" stop-color="#6fa832" />
      <stop offset="1" stop-color="#1f4a16" />
    </linearGradient>
    <radialGradient id={id('pit')} cx=".5" cy=".85" r=".75">
      <stop offset="0" stop-color="#5a2a0e" />
      <stop offset=".6" stop-color="#2a1208" />
      <stop offset="1" stop-color="#140905" />
    </radialGradient>
    <linearGradient id={id('flame')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff3c0" />
      <stop offset=".3" stop-color="#ffd05a" />
      <stop offset=".7" stop-color="#e88a24" />
      <stop offset="1" stop-color="#9c4210" />
    </linearGradient>
    <linearGradient id={id('flame-in')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fffbe6" />
      <stop offset="1" stop-color="#ffd463" />
    </linearGradient>
    <radialGradient id={id('spark')}>
      <stop offset="0" stop-color="#fffbe8" />
      <stop offset=".3" stop-color="#ffe39a" stop-opacity=".8" />
      <stop offset="1" stop-color="#f2c14e" stop-opacity="0" />
    </radialGradient>
    <clipPath id={id('in')}><path d="M300 60 508.5 382H91.5Z" /></clipPath>
    <clipPath id={id('pitc')}><path d="M128 382 300 255 472 382Z" /></clipPath>
  </defs>

  <g clip-path={u('in')}>
    <!-- общий фон: слева глубокий синий, справа тёмно-зелёный, без шва -->
    <path class="ev-bg" d="M300 40 560 384H40Z" fill={u('bg')} />
    <!-- вода -->
    <g class="ev-part ev-water">
      <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        {waves.map((w) => <path d={w.d} stroke="#020a22" stroke-width={w.w + 4} opacity={0.6 * w.o} />)}
        {waves.map((w) => <path d={w.d} stroke={u('wave')} stroke-width={w.w} opacity={w.o} />)}
        {waves.slice(0, 3).map((w) => <path d={w.d} stroke="#eaf5ff" stroke-width="1.3" opacity=".75" transform="translate(0 -2)" />)}
      </g>
      <path class="ev-drop" d="M212 216c0 0 23 31 23 50a23 23 0 0 1-46 0c0-19 23-50 23-50Z" fill={u('drop')} stroke="#d9ecff" stroke-opacity=".6" stroke-width="1.5" />
      <path d="M200 262c0-9 5-19 9-25" fill="none" stroke="#f2f9ff" stroke-width="3" stroke-linecap="round" opacity=".9" />
    </g>
    <!-- лист -->
    <g class="ev-part ev-leaf">
      <path d="M362 232c40 4 98 36 130 128-52-6-112-44-130-128Z" fill={u('leaf')} stroke="#eaf8b8" stroke-opacity=".55" stroke-width="1.2" />
      <path d="M366 236c44 30 92 74 124 122" fill="none" stroke="#f3dc8c" stroke-width="1.8" opacity=".9" />
      <path d="M392 262l18-4M414 286l20-2M438 312l18 0M400 276l-4 14M424 300l-4 14" fill="none" stroke="#f3dc8c" stroke-width="1" opacity=".5" />
      <path d="M356 264c-8-40 4-70 30-94 10 36-2 70-30 94Z" fill={u('leaf')} stroke="#eaf8b8" stroke-opacity=".55" stroke-width="1.2" />
      <path d="M358 260c6-28 14-52 28-86" fill="none" stroke="#f3dc8c" stroke-width="1.5" opacity=".9" />
    </g>
    <!-- башни -->
    <g class="ev-part ev-towers">
      {towers.map((t, i) => {
        const sl = i % 2 ? 9 : -9;
        const yl = t.top + (sl > 0 ? sl : 0), yr = t.top + (sl < 0 ? -sl : 0);
        const floors = [];
        for (let y = t.top + 22; y < 300; y += 13) floors.push(y);
        return (
          <g class="ev-tower" style={`--k:${i}`}>
            <path d={`M${t.x} 330V${yl}L${t.x + t.w} ${yr}V330Z`} fill={u('tower')} />
            <path d={floors.map((y) => `M${t.x + 2} ${y}h${t.w - 4}`).join('')} stroke="#cfe4ff" stroke-width="1" opacity=".22" />
            <path d={`M${t.x + 0.75} 330V${yl}`} stroke="#f6d98a" stroke-width="1.5" opacity=".85" />
            <path d={`M${t.x + t.w - 0.75} 330V${yr}`} stroke="#c99a3a" stroke-width="1.5" />
            <path d={`M${t.x} ${yl}L${t.x + t.w} ${yr}`} stroke="#ffeab0" stroke-width="2.4" stroke-linecap="round" />
          </g>
        );
      })}
      {front.map((t, i) => (
        <g class="ev-tower" style={`--k:${i + 3}`}>
          <path d={`M${t.x} 330V${t.top + 6}L${t.x + t.w} ${t.top}V330Z`} fill={u('tower2')} />
          <path d={`M${t.x} ${t.top + 6}L${t.x + t.w} ${t.top}`} stroke="#f6d98a" stroke-width="2" />
          <path d={`M${t.x + t.w - 0.75} 330V${t.top}`} stroke="#d9aa48" stroke-width="1.5" />
        </g>
      ))}
    </g>
    <!-- нижний отсек: трубы -->
    <g class="ev-part ev-pipes" clip-path={u('pitc')}>
      <path d="M128 382 300 255 472 382Z" fill={u('pit')} />
      <g fill="none" stroke-linejoin="round">
        <path d="M136 372H240V300M166 356H222V305M464 372H360V300M434 356H378V305" stroke="#3a1707" stroke-width="12" />
        <path d="M136 372H240V300M166 356H222V305M464 372H360V300M434 356H378V305" stroke="#c46a34" stroke-width="8" />
        <path d="M136 372H240V300M166 356H222V305M464 372H360V300M434 356H378V305" stroke="#ffc99c" stroke-width="2" opacity=".85" />
      </g>
      <g fill="#e8a266" stroke="#5a260c" stroke-width="1">
        <rect x="188" y="365" width="6" height="14" rx="1" />
        <rect x="233" y="330" width="14" height="6" rx="1" />
        <rect x="406" y="365" width="6" height="14" rx="1" />
        <rect x="353" y="330" width="14" height="6" rx="1" />
      </g>
    </g>
  </g>

  <!-- «крыша» над нижним отсеком -->
  <path class="ev-part ev-chev" d="M91.5 382 300 228 508.5 382H472L300 255 128 382Z" fill={u('chev')} />
  <path class="ev-part ev-chev" d="M100 377 300 229.5 500 377" fill="none" stroke="#fff4cf" stroke-width="1.4" opacity=".85" />

  <!-- рамка: наружная светлая грань + внутренняя тёмная фаска -->
  <path class="ev-frame-fill" d="M300 8 560 410H40ZM300 41 73.1 392H526.9Z" fill={u('frame')} fill-rule="evenodd" />
  <path class="ev-frame-fill" d="M300 41 526.9 392H73.1ZM300 60 91.5 382H508.5Z" fill={u('bevel')} fill-rule="evenodd" />
  <path class="ev-frame-fill" d="M300 8 560 410H40ZM300 60 91.5 382H508.5Z" fill={u('frame2')} fill-rule="evenodd" opacity=".22" />
  <path class="ev-frame-fill" d="M300 41 526.9 392H73.1Z" fill="none" stroke="#fff3c4" stroke-width="1.2" opacity=".7" />
  <path class="ev-frame-fill" d="M300 60 508.5 382H91.5Z" fill="none" stroke="#241603" stroke-width="2.4" />
  <path class="ev-frame-line" d="M300 8 560 410H40Z" fill="none" stroke="#fff0bf" stroke-width="2" pathLength="1" />

  <!-- пламя с молнией -->
  <g class="ev-part ev-flame">
    <path d="M300 406C270 400 257 374 261 347 265 318 288 302 284 270 300 283 307 300 303 319 317 300 319 268 306 234 335 257 345 296 341 331 338 371 325 400 300 406Z" fill={u('flame')} stroke="#ffe7a0" stroke-opacity=".75" stroke-width="1.5" />
    <path d="M300 391C284 387 277 371 280 355 283 340 294 330 294 313 303 321 307 333 304 345 312 337 316 323 313 307 325 321 329 340 327 356 325 376 315 389 300 391Z" fill={u('flame-in')} opacity=".92" />
    <path d="M307 300 288 340H300L293 376 319 330H306L315 300Z" fill="#fffdf2" stroke="#b9781c" stroke-width="1.8" stroke-linejoin="round" />
  </g>
  <circle class="ev-spark" cx="300" cy="9" r="16" fill={u('spark')} />
</svg>
