---
// Золотые line-art визуализации услуг (волна 2): у каждой услуги своя сцена по смыслу.
// Подписи — служебные названия элементов схемы, без фактов. Декоративный слой, aria-hidden.
// Классы sa-* общие со SystemArt (рисование при появлении, «поток»). sa-seg — сегменты, собираемые по прокрутке (--p).
const { slug, class: cls = '' } = Astro.props;
const hatch = (y: number, from = 0, to = 480, step = 16) =>
  Array.from({ length: Math.floor((to - from) / step) }, (_, i) => `M${from + i * step} ${y + 9}l9 -9`).join('');
const rso = [
  { t: 'МОЭК', x: 240, y: 46 },
  { t: 'Мосводоканал', x: 418, y: 120 },
  { t: 'Россети', x: 372, y: 272 },
  { t: 'ОЭК', x: 108, y: 272 },
  { t: 'Мосгаз', x: 62, y: 120 },
];
---
<svg class:list={['sa', 'sa-svc', `sa--${slug}`, cls]} viewBox="0 0 480 320" fill="none" aria-hidden="true" data-reveal data-scrub={slug === 'montazh-truboprovoda' ? '' : undefined}>
  <defs>
    <pattern id={`sv-grid-${slug}`} width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M24 0H0V24" stroke="currentColor" stroke-opacity=".07" stroke-width="1" />
    </pattern>
  </defs>
  <rect width="480" height="320" fill={`url(#sv-grid-${slug})`} />

  {slug === 'tekhnicheskiy-zakazchik' && (
    <g>
      <path class="sa-pipe sa-pipe--thin" d="M110 160H200M280 160L380 70M280 160H380M280 160L380 250" />
      <path class="sa-flow sa-flow--soft" d="M110 160H200M280 160L380 70M280 160H380M280 160L380 250" />
      <circle class="sa-draw" pathLength="1" cx="240" cy="160" r="40" />
      <circle class="sa-line sa-faint" cx="240" cy="160" r="54" />
      <text class="sa-label sa-label--big" x="240" y="166" text-anchor="middle">ВиК</text>
      <rect class="sa-draw" pathLength="1" x="20" y="130" width="90" height="60" rx="8" />
      <text class="sa-label" x="65" y="165" text-anchor="middle">Заказчик</text>
      {[['Проектировщик', 70], ['РСО', 160], ['Подрядчики', 250]].map(([t, y]) => (
        <g>
          <rect class="sa-draw" pathLength="1" x="380" y={(y as number) - 22} width="88" height="44" rx="8" />
          <text class="sa-label" x="424" y={(y as number) + 4} text-anchor="middle">{t}</text>
        </g>
      ))}
    </g>
  )}

  {slug === 'proektirovanie-i-soglasovaniya' && (
    <g>
      {[0, 1, 2].map((k) => (
        <g class="sa-seg" style={`--k:${k}`}>
          <rect class="sa-draw" pathLength="1" x={60 + k * 26} y={40 + k * 22} width="200" height="230" rx="4" />
          <path class="sa-line sa-faint" d={`M${60 + k * 26 + 120} ${40 + k * 22 + 200}h80v30M${60 + k * 26 + 120} ${40 + k * 22 + 215}h80`} />
        </g>
      ))}
      <path class="sa-line" d="M140 170h140M140 190h96M160 120h100v40H160z" />
      <text class="sa-label sa-label--big" x="74" y="68">П</text>
      <text class="sa-label sa-label--big" x="152" y="112">Р</text>
      <path class="sa-pipe sa-pipe--thin" d="M330 80V250" />
      <path class="sa-flow" d="M330 80V250" />
      {[80, 165, 250].map((y) => <circle class="sa-dot" cx="330" cy={y} r="7" />)}
      <circle class="sa-line" cx="420" cy="250" r="26" />
      <path class="sa-line" d="M408 250l8 8 16-16" />
      <text class="sa-label" x="344" y="84">Проект</text>
      <text class="sa-label" x="344" y="169">Согласования</text>
      <text class="sa-label" x="356" y="300">Согласовано</text>
    </g>
  )}

  {slug === 'soglasovanie-rso' && (
    <g>
      {rso.map((o) => <path class="sa-line sa-faint" d={`M240 160L${o.x} ${o.y}`} />)}
      <path class="sa-pipe sa-pipe--thin" d={`M${rso.map((o) => `${o.x} ${o.y}`).join('L')}Z`} />
      <path class="sa-flow" d={`M${rso.map((o) => `${o.x} ${o.y}`).join('L')}Z`} />
      <path class="sa-draw" pathLength="1" d="M222 132h28l12 12v44h-40z" />
      <path class="sa-line" d="M230 156h24M230 166h24M230 176h16" />
      {rso.map((o) => (
        <g>
          <circle class="sa-dot" cx={o.x} cy={o.y} r="6" />
          <circle class="sa-line sa-faint" cx={o.x} cy={o.y} r="13" />
          <text class="sa-label" x={o.x} y={o.y < 160 ? o.y - 20 : o.y + 30} text-anchor="middle">{o.t}</text>
        </g>
      ))}
    </g>
  )}

  {slug === 'smr' && (
    <g>
      <path class="sa-base" d="M30 270H450" />
      {[0, 1, 2, 3, 4].map((k) => (
        <g class="sa-seg" style={`--k:${k}`}>
          <rect class="sa-line" x={40 + k * 66} y={60 + k * 40} width={150} height="22" rx="11" />
          <rect class="sa-dot sa-fill" x={40 + k * 66} y={60 + k * 40} width={60} height="22" rx="11" />
        </g>
      ))}
      {[0, 1, 2, 3, 4, 5].map((k) => <path class="sa-line sa-faint" d={`M${40 + k * 80} 262v16`} />)}
      <path class="sa-flow" d="M40 290H440" />
    </g>
  )}

  {slug === 'dokumentatsiya-i-sdacha' && (
    <g>
      {[['Журналы', 0], ['Схемы', 1], ['Акты', 2]].map(([t, k]) => (
        <g class="sa-seg" style={`--k:${k}`}>
          <rect class="sa-draw" pathLength="1" x={90 + (k as number) * 70} y={70 - (k as number) * 16} width="170" height="220" rx="6" transform={`rotate(${((k as number) - 1) * 6} ${175 + (k as number) * 70} 180)`} />
          <text class="sa-label" x={110 + (k as number) * 70} y={100 - (k as number) * 16} transform={`rotate(${((k as number) - 1) * 6} ${175 + (k as number) * 70} 180)`}>{t}</text>
        </g>
      ))}
      <path class="sa-line" d="M260 150h120M260 172h90M260 194h110M300 230l14 14 30-30" />
    </g>
  )}

  {slug === 'zemlyanye-raboty' && (
    <g>
      <path class="sa-base" d="M0 90H480" />
      <path class="sa-hatch" d={hatch(90)} />
      <path class="sa-line sa-faint" d="M0 150H130M210 150H300M0 210H130M210 210H300M0 260H480" />
      <path class="sa-hatch" d={hatch(160, 0, 128, 10)} />
      <path class="sa-hatch" d={hatch(220, 0, 128, 22)} />
      <path class="sa-draw" pathLength="1" d="M110 90L134 250H206L230 90" />
      <circle class="sa-pipe sa-pipe--thin" cx="170" cy="232" r="10" />
      <circle class="sa-dot" cx="170" cy="232" r="4" />
      <path class="sa-line" d="M300 90h150M300 80h150" />
      <path class="sa-pipe sa-pipe--thin" d="M300 110Q375 250 450 110" />
      <path class="sa-flow" d="M300 110Q375 250 450 110" />
      <text class="sa-label" x="128" y="282">Траншея</text>
      <text class="sa-label" x="356" y="232">ГНБ</text>
      <text class="sa-label" x="340" y="70">Дорога</text>
    </g>
  )}

  {slug === 'montazh-truboprovoda' && (
    <g>
      <path class="sa-base sa-faint" d="M20 220H460" />
      {[0, 1, 2, 3, 4].map((k) => (
        <g class="sa-seg sa-seg--scrub" style={`--k:${k}`}>
          <rect class="sa-line" x={30 + k * 86} y="150" width="80" height="40" rx="6" />
          <path class="sa-line sa-faint" d={`M${40 + k * 86} 160h60`} />
          <rect class="sa-dot sa-fill" x={106 + k * 86} y="144" width="8" height="52" rx="2" />
        </g>
      ))}
      <path class="sa-flow" d="M30 170H460" />
      <path class="sa-line sa-dash" d="M30 110H460" />
      <text class="sa-label" x="30" y="100">Сборка по секциям</text>
      <text class="sa-label" x="30" y="250">Испытание</text>
    </g>
  )}

  {slug === 'montazh-kabelya' && (
    <g>
      <path class="sa-base" d="M0 120H360" />
      <path class="sa-hatch" d={hatch(120, 0, 360)} />
      <path class="sa-draw" pathLength="1" d="M360 40V300M360 40h100v260" />
      <path class="sa-pipe sa-pipe--thin" d="M20 230H330Q346 230 346 214V180H420" />
      <path class="sa-flow sa-flow--fast" d="M20 230H330Q346 230 346 214V180H420" />
      <rect class="sa-line" x="110" y="221" width="30" height="18" rx="4" />
      <rect class="sa-line" x="230" y="221" width="30" height="18" rx="4" />
      <rect class="sa-draw" pathLength="1" x="400" y="140" width="44" height="80" rx="3" />
      <path class="sa-line" d="M410 156h24M410 172h24M410 188h24" />
      <text class="sa-label" x="104" y="262">Муфта</text>
      <text class="sa-label" x="224" y="262">Муфта</text>
      <text class="sa-label" x="372" y="252">Ввод в здание</text>
    </g>
  )}

  {slug === 'proektirovanie-itp' && (
    <g>
      <!-- изометрия: рама узла -->
      <path class="sa-draw" pathLength="1" d="M120 220L240 280 400 200 280 140ZM120 220V120L280 40 400 100V200M240 280V180L120 120M240 180L400 100" />
      <!-- пакет пластин теплообменника -->
      {[0, 1, 2, 3, 4].map((k) => (
        <path class="sa-line sa-seg" style={`--k:${k}`} d={`M${196 + k * 10} ${140 + k * 5}l0 -60 40 -20 0 60z`} />
      ))}
      <path class="sa-pipe sa-pipe--thin sa-hot" d="M60 190L150 145 190 165" />
      <path class="sa-flow sa-hot" d="M60 190L150 145 190 165" />
      <path class="sa-pipe sa-pipe--thin sa-cold" d="M290 140L330 160 420 115" />
      <path class="sa-flow sa-cold" d="M290 140L330 160 420 115" />
      <ellipse class="sa-line" cx="330" cy="200" rx="18" ry="11" />
      <path class="sa-line" d="M312 200v18a18 11 0 0 0 36 0v-18" />
      <text class="sa-label" x="40" y="214">Теплосеть</text>
      <text class="sa-label" x="370" y="240">Насос</text>
      <text class="sa-label" x="186" y="66">Теплообменник</text>
    </g>
  )}

  {slug === 'tekhprisoedinenie-i-tu' && (
    <g>
      <path class="sa-pipe sa-pipe--thin" d="M40 270C120 270 120 190 200 190S280 110 360 110 440 40 440 40" />
      <path class="sa-flow" d="M40 270C120 270 120 190 200 190S280 110 360 110 440 40 440 40" />
      {[[40, 270], [200, 190], [360, 110], [440, 40]].map(([x, y], k) => (
        <g class="sa-seg" style={`--k:${k}`}>
          <circle class="sa-dot" cx={x} cy={y} r="7" />
          <path class="sa-line" d={`M${x} ${y - 8}v-34l22 9-22 9`} />
        </g>
      ))}
      <text class="sa-label" x="24" y="300">Запрос ТУ</text>
      <text class="sa-label" x="384" y="30" text-anchor="end">Договор</text>
    </g>
  )}

  {slug === 'vynos-setey' && (
    <g>
      <path class="sa-line sa-faint" d="M240 30V290" />
      <rect class="sa-draw" pathLength="1" x="60" y="110" width="120" height="100" rx="4" />
      <path class="sa-hatch" d="M70 200l90-80M90 200l80-72M70 172l60-54M110 200l60-54" />
      <path class="sa-pipe sa-pipe--thin" d="M20 160H220" />
      <path class="sa-line sa-dash sa-warn" d="M60 160H180" />
      <rect class="sa-draw" pathLength="1" x="300" y="110" width="120" height="100" rx="4" />
      <path class="sa-hatch" d="M310 200l90-80M330 200l80-72M310 172l60-54M350 200l60-54" />
      <path class="sa-pipe sa-pipe--thin" d="M260 160H284V250H436V160H460" />
      <path class="sa-flow" d="M260 160H284V250H436V160H460" />
      <text class="sa-label sa-label--big" x="20" y="56">До</text>
      <text class="sa-label sa-label--big" x="260" y="56">После</text>
      <text class="sa-label" x="62" y="100">Пятно застройки</text>
      <text class="sa-label" x="302" y="100">Пятно застройки</text>
      <text class="sa-label" x="300" y="280">Новая трасса</text>
    </g>
  )}

  {slug === 'ekspertiza' && (
    <g>
      <circle class="sa-pipe sa-pipe--thin" cx="240" cy="165" r="104" />
      <circle class="sa-flow" cx="240" cy="165" r="104" />
      {[[240, 61, 'Замечание'], [330, 217, 'Ответ'], [150, 217, 'Исправление']].map(([x, y, t], k) => (
        <g class="sa-seg" style={`--k:${k}`}>
          <circle class="sa-draw" pathLength="1" cx={x} cy={y} r="22" style="fill:var(--bg-2)" />
          <circle class="sa-dot" cx={x} cy={y} r="5" />
          <text class="sa-label" x={x} y={(y as number) < 100 ? (y as number) - 32 : (y as number) + 42} text-anchor="middle">{t}</text>
        </g>
      ))}
      <path class="sa-line" d="M300 96l14 4-4 14M290 270l-14 4 4-14M108 130l2-14 12 8" />
      <path class="sa-line" d="M226 160l10 10 20-20" />
    </g>
  )}
</svg>
