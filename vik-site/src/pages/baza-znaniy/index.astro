---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import IntakeForm from '../../components/IntakeForm.astro';
import { articles, knowledgeBase, serviceByPath, directionByPath } from '../../content/index.mjs';
const pad = (i: number) => String(i + 1).padStart(2, '0');
const fmt = (d: string) => d.split('-').reverse().join('.');
// темы карточки — по связанным страницам (первые две)
const topics = (a: any) => a.related.map((p: string) => serviceByPath(p) ?? directionByPath(p)).filter(Boolean).slice(0, 2).map((x: any) => ({ label: x.label, icon: x.icon }));
---
<Base title={knowledgeBase.title} description={knowledgeBase.description} path="/baza-znaniy/" crumbs={[{ name: 'Главная', href: '/' }, { name: knowledgeBase.h1, href: '/baza-znaniy/' }]}>
  <section class="page-hero kb-hero">
    <div class="container">
      <p class="crumbs"><a href="/">Главная</a><span class="sep"></span>{knowledgeBase.h1}</p>
      <p class="eyebrow">Статьи · {articles.length}</p>
      <h1>{knowledgeBase.h1}</h1>
      <p class="lead">{knowledgeBase.lead}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ol class="kb-grid">
        {articles.map((a: any, i: number) => (
          <li data-reveal style={`--i:${i}`} class:list={[{ 'kb-wide': i === 0 }]}>
            <a class="kb-card" href={`/baza-znaniy/${a.slug}/`}>
              <span class="kb-top"><span class="kb-n">{pad(i)}</span><span class="kb-meta"><Icon name="clock" size={14} /> {a.readMin} мин · {fmt(a.updated)}</span></span>
              <span class="kb-t">{a.h1}</span>
              <span class="kb-l">{a.lead}</span>
              <span class="kb-tags">{topics(a).map((t: any) => <span class="kb-tag"><Icon name={t.icon} size={14} />{t.label}</span>)}</span>
              <span class="link-go">Читать статью <span class="btn-ico"><Icon name="arrow" size={14} /></span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <IntakeForm />
</Base>
