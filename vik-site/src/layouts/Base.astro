---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consultant from '../components/Consultant.astro';
import Intro from '../components/Intro.astro';
import { indexing } from '../data/site';

const { title, description, path = '/', noindex = false, crumbs = [] } = Astro.props;
const variants = import.meta.env.PUBLIC_VARIANTS === '1';
const intro = path === '/';
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const canonical = indexing ? `${site}${path}` : undefined;
const robots = !indexing || noindex ? 'noindex, nofollow' : 'index, follow';
const breadcrumbLd =
  indexing && crumbs.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c: { name: string; href: string }, i: number) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: `${site}${c.href}`,
        })),
      }
    : null;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a090c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/cormorant-garamond-cyrillic-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <script is:inline>
      (function () {
        var d = document.documentElement; d.classList.add('js');
        try { if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) d.classList.add('motion'); } catch (e) {}
      })();
    </script>
    {intro && (
      <script is:inline>
        (function () {
          var d = document.documentElement;
          try {
            if (d.classList.contains('motion') && !location.hash && !sessionStorage.getItem('vik-intro')) {
              d.classList.add('intro-on', 'intro-ran');
              setTimeout(function () { d.classList.remove('intro-on', 'intro-out'); }, 3000);
            }
          } catch (e) {}
        })();
      </script>
    )}
    {variants && (
      <script is:inline>
        try { var q = new URLSearchParams(location.search).get('v'); if (q) localStorage.setItem('vik-variant', q === 'gold' ? '' : q);
          var v = localStorage.getItem('vik-variant'); if (v) document.documentElement.dataset.variant = v; } catch (e) {}
      </script>
    )}
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  </head>
  <body>
    {intro && <Intro />}
    <a class="skip" href="#main">К содержимому</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Consultant />
    {variants && (
      <div class="variants" role="group" aria-label="Вариант оформления">
        <button type="button" data-variant-btn="gold">Золото</button>
        <button type="button" data-variant-btn="indigo">Индиго</button>
        <button type="button" data-variant-btn="light">Светлый</button>
      </div>
      <script is:inline>
        (function () {
          var cur = document.documentElement.dataset.variant || 'gold';
          document.querySelectorAll('[data-variant-btn]').forEach(function (b) {
            var k = b.dataset.variantBtn; b.setAttribute('aria-pressed', String(k === cur));
            b.addEventListener('click', function () { try { localStorage.setItem('vik-variant', k === 'gold' ? '' : k); } catch (e) {} location.reload(); });
          });
        })();
      </script>
    )}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reduce = !root.classList.contains('motion');

        // меню
        var t = document.querySelector('[data-menu-toggle]');
        var n = document.getElementById('main-nav');
        var header = document.querySelector('[data-header]');
        function setMenu(open) {
          n.classList.toggle('open', open);
          t.setAttribute('aria-expanded', open ? 'true' : 'false');
          root.classList.toggle('menu-open', open);
        }
        if (t && n) {
          t.addEventListener('click', function () { setMenu(!n.classList.contains('open')); });
          n.addEventListener('click', function (e) { if (e.target.closest('a') && n.classList.contains('open')) setMenu(false); });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && n.classList.contains('open')) { setMenu(false); t.focus(); } });
        }

        // шапка: прячется при прокрутке вниз, возвращается при прокрутке вверх
        var lastY = window.scrollY, hTick = false;
        function onHeader() {
          hTick = false;
          var y = window.scrollY;
          if (header) {
            header.classList.toggle('is-scrolled', y > 24);
            if (!root.classList.contains('menu-open')) header.classList.toggle('is-hidden', y > 320 && y > lastY + 2);
            if (y < lastY - 2) header.classList.remove('is-hidden');
          }
          lastY = y;
        }
        window.addEventListener('scroll', function () { if (!hTick) { hTick = true; requestAnimationFrame(onHeader); } }, { passive: true });
        onHeader();

        // появление блоков
        var items = document.querySelectorAll('[data-reveal]');
        if (reduce) { items.forEach(function (el) { el.classList.add('is-in'); }); }
        else {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
          items.forEach(function (el) { io.observe(el); });
          // страховка: если элемент уже выше экрана (переход по якорю), показать сразу
          setTimeout(function () { items.forEach(function (el) { if (el.getBoundingClientRect().bottom < 0) el.classList.add('is-in'); }); }, 400);
        }

        // этапы маршрута: подсветка по мере прокрутки
        var steps = document.querySelectorAll('[data-step]');
        if (steps.length) {
          if (reduce) steps.forEach(function (s) { s.classList.add('is-lit'); });
          else {
            var so = new IntersectionObserver(function (es) {
              es.forEach(function (e) { var above = e.boundingClientRect.top < window.innerHeight * 0.6; e.target.classList.toggle('is-lit', e.isIntersecting || above); });
            }, { rootMargin: '0px 0px -40% 0px', threshold: 0 });
            steps.forEach(function (s) { so.observe(s); });
          }
        }

        // параллакс слоёв: data-depth (доля скорости прокрутки) внутри [data-parallax]
        if (!reduce) {
          var scenes = Array.prototype.slice.call(document.querySelectorAll('[data-parallax]'));
          var pTick = false;
          function onPar() {
            pTick = false;
            var vh = window.innerHeight;
            scenes.forEach(function (sc) {
              var r = sc.getBoundingClientRect();
              if (r.bottom < -100 || r.top > vh + 100) return;
              var off = sc.hasAttribute('data-parallax-center') ? (r.top + r.height / 2 - vh / 2) : -r.top;
              sc.querySelectorAll('[data-depth]').forEach(function (l) {
                l.style.setProperty('--py', (off * parseFloat(l.getAttribute('data-depth'))).toFixed(1) + 'px');
              });
            });
          }
          if (scenes.length) { window.addEventListener('scroll', function () { if (!pTick) { pTick = true; requestAnimationFrame(onPar); } }, { passive: true }); onPar(); }

          // наклон эмблемы за курсором (только мышь)
          var tilt = document.querySelector('[data-tilt]');
          if (tilt && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            var area = tilt.closest('section') || document.body, tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
            function loop() { cx += (tx - cx) * 0.08; cy += (ty - cy) * 0.08; tilt.style.setProperty('--rx', cy.toFixed(2) + 'deg'); tilt.style.setProperty('--ry', cx.toFixed(2) + 'deg');
              if (Math.abs(tx - cx) > 0.01 || Math.abs(ty - cy) > 0.01) raf = requestAnimationFrame(loop); else raf = 0; }
            area.addEventListener('pointermove', function (e) {
              var r = area.getBoundingClientRect(); tx = ((e.clientX - r.left) / r.width - 0.5) * 10; ty = -((e.clientY - r.top) / r.height - 0.5) * 8;
              if (!raf) raf = requestAnimationFrame(loop);
            });
            area.addEventListener('pointerleave', function () { tx = 0; ty = 0; if (!raf) raf = requestAnimationFrame(loop); });
          }
        }

        // сборка по прокрутке: [data-scrub] получает --p от 0 до 1, пока проходит экран
        var scrubs = Array.prototype.slice.call(document.querySelectorAll('[data-scrub]'));
        if (scrubs.length && !reduce) {
          var sTick = false;
          function onScrub() { sTick = false; var vh = window.innerHeight; scrubs.forEach(function (el) { var r = el.getBoundingClientRect(); var p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.75))); el.style.setProperty('--p', p.toFixed(3)); }); }
          window.addEventListener('scroll', function () { if (!sTick) { sTick = true; requestAnimationFrame(onScrub); } }, { passive: true }); onScrub();
        }

        // телефон: плавающая кнопка консультанта не перекрывает кнопки первого экрана
        var heroCta = document.querySelector('.hero .cta');
        if (heroCta && 'IntersectionObserver' in window) {
          new IntersectionObserver(function (es) { root.classList.toggle('hero-cta-in', es[0].isIntersecting); }, { threshold: 0 }).observe(heroCta);
        }

        // перенос параметров в форму заявки
        var f = document.querySelector('[data-intake]');
        if (f) {
          var p = new URLSearchParams(location.search);
          ['direction', 'service', 'stage'].forEach(function (k) {
            var v = p.get(k);
            var el = f.elements[k];
            if (v && el) el.value = v;
          });
        }
      })();
    </script>
  </body>
</html>
